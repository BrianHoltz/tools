"""
walmart-sync — deterministic mirror audit/sync helper

Design:
- Thin orchestrator logic in this file
- Declarative policy/manifest in walmart-sync.json
"""

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

TOOLS = Path.home() / "src" / "tools"
SHARED = Path.home() / "src" / "relationship-shared"
CFG_PATH = Path(__file__).with_suffix(".json")
TOOLS_REPO_LABEL = "~/src/tools"

GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
CYAN = "\033[36m"
RESET = "\033[0m"
BOLD = "\033[1m"


def c(color, text):
    return f"{color}{text}{RESET}"


def run_git(repo: Path, *args, capture=True):
    cmd = ["git", "-C", str(repo)] + list(args)
    return subprocess.run(cmd, capture_output=capture, text=capture)


def load_cfg():
    try:
        return json.loads(CFG_PATH.read_text())
    except Exception as e:
        print(c(RED + BOLD, f"ERROR: cannot read {CFG_PATH}: {e}"))
        sys.exit(1)


def parse_porcelain_paths(text):
    paths = []
    for raw in text.splitlines():
        if len(raw) < 4:
            continue
        path = raw[3:]
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        paths.append(path.strip())
    return paths


def detect_upstream(repo: Path):
    r = run_git(repo, "rev-parse", "--abbrev-ref", "HEAD@{upstream}")
    if r.returncode == 0:
        parts = r.stdout.strip().split("/", 1)
        if len(parts) == 2:
            return parts[0], parts[1]
    b = run_git(repo, "branch", "--show-current")
    return "origin", (b.stdout.strip() or "main")


def compile_patterns(pattern_specs):
    return [(re.compile(pat, re.IGNORECASE), label) for pat, label in pattern_specs]


def collect_files(path: Path):
    if path.is_file():
        return [path]
    if path.is_dir():
        return sorted(path.rglob("*"))
    return []


def grep_patterns(path: Path, compiled, skip_url_lines=False):
    hits = []
    try:
        text = path.read_text(errors="replace")
    except Exception:
        return hits
    for lineno, line in enumerate(text.splitlines(), 1):
        if skip_url_lines and re.search(r"https?://", line, re.IGNORECASE):
            continue
        for rx, label in compiled:
            if rx.search(line):
                hits.append((lineno, line.rstrip(), label))
                break
    return hits


def walmart_sync_specs(cfg):
    exact = set(cfg.get("managed_exact", []))
    prefixes = [p.rstrip("/") + "/" for p in cfg.get("managed_prefixes", [])]
    for item in cfg["mirror_items"]:
        dst = item["tools_rel"]
        if item["is_dir"]:
            prefixes.append(dst.rstrip("/") + "/")
        else:
            exact.add(dst)
    for item in cfg["personal_only"]:
        if item.endswith("/"):
            prefixes.append(item.rstrip("/") + "/")
        else:
            exact.add(item)
    return exact, prefixes


def mirror_only_specs(cfg):
    """Like walmart_sync_specs, but mirror_items only -- excludes personal_only.

    Used to gate pushes: personal_only files may be freely pushed from either
    laptop, but mirror_items have a canonical source (relationship-shared) and
    must never be hand-edited on the personal laptop, where that source isn't
    visible."""
    exact = set()
    prefixes = []
    for item in cfg["mirror_items"]:
        dst = item["tools_rel"]
        if item["is_dir"]:
            prefixes.append(dst.rstrip("/") + "/")
        else:
            exact.add(dst)
    return exact, prefixes


def is_managed(path: str, exact, prefixes):
    if path in exact:
        return True
    return any(path.startswith(prefix) for prefix in prefixes)


def block_if_managed_changes(cfg, action_label: str):
    exact, prefixes = walmart_sync_specs(cfg)
    status = run_git(TOOLS, "status", "--porcelain")
    dirty = parse_porcelain_paths(status.stdout)
    managed = [p for p in dirty if is_managed(p, exact, prefixes)]
    if not managed:
        return True
    print(c(RED + BOLD, f"⚠ Commit-first policy: cannot {action_label} with local walmart-sync changes."))
    print(c(RED, "Commit these files first, then rerun walmart-sync:"))
    for p in managed:
        print(f"  - {p}")
    print()
    print(c(CYAN, f"Suggested: cd {TOOLS_REPO_LABEL} && git add <files> && git commit"))
    return False


def pull_repo(repo: Path, label: str, cfg=None, check_managed_only=False):
    status = run_git(repo, "status", "--porcelain")
    dirty = parse_porcelain_paths(status.stdout)

    # If checking managed files only (for shared repo), filter to mirror items
    if check_managed_only and cfg:
        exact, prefixes = walmart_sync_specs(cfg)
        dirty = [p for p in dirty if is_managed(p, exact, prefixes)]

    if dirty:
        print(c(RED + BOLD, f"⚠ Commit-first policy: cannot pull {label} with local changes."))
        print(c(RED, "Commit these files first, then rerun walmart-sync:"))
        for p in dirty:
            print(f"  - {p}")
        print()
        print(c(CYAN, f"Suggested: cd {repo} && git add <files> && git commit"))
        return False
    remote, branch = detect_upstream(repo)
    print(c(CYAN, f"Pulling {label} from {remote}/{branch} (merge)…"))
    r = run_git(repo, "pull", "--no-rebase", remote, branch, capture=False)
    if r.returncode != 0:
        print(c(RED + BOLD, f"⚠ Pull failed for {label}. Resolve and rerun."))
        return False
    return True


def git_show_bytes(repo: Path, rev: str, rel_path: str):
    r = subprocess.run(["git", "-C", str(repo), "show", f"{rev}:{rel_path}"], capture_output=True)
    if r.returncode != 0:
        return None
    return r.stdout


def recent_shared_shas(rel_path: str, days: int):
    r = subprocess.run(
        ["git", "-C", str(SHARED), "log", f"--since={days} days ago", "--format=%H", "--", rel_path],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        return []
    return [line.strip() for line in r.stdout.splitlines() if line.strip()]


def mirror_content_is_legitimate(rel_path: str, candidate: bytes, days: int) -> bool:
    """True if `candidate` bytes match relationship-shared's current content for
    rel_path, or any commit of it within the last `days` days. Checks HEAD
    first (the common case: tools is simply stale), then walks history
    newest-first and stops at the first match -- cheap in the happy path,
    bounded in the sad path. False means this content never legitimately
    existed in relationship-shared within the window -- i.e. it was hand-edited
    directly in tools, not copied from the canonical source."""
    current = git_show_bytes(SHARED, "HEAD", rel_path)
    if current is not None and current == candidate:
        return True
    for sha in recent_shared_shas(rel_path, days):
        if git_show_bytes(SHARED, sha, rel_path) == candidate:
            return True
    return False


def dir_file_diffs(src: Path, dst: Path):
    """Yield relative sub-paths that differ (or exist only on one side)
    between two directory trees."""
    src_files = {f.relative_to(src) for f in collect_files(src) if f.is_file()} if src.is_dir() else set()
    dst_files = {f.relative_to(dst) for f in collect_files(dst) if f.is_file()} if dst.is_dir() else set()
    for rel in sorted(src_files | dst_files, key=str):
        s, d = src / rel, dst / rel
        if not s.is_file() or not d.is_file() or s.read_bytes() != d.read_bytes():
            yield rel


def classify_mirror_item(item, cfg):
    """Classify one mirror item's current state.

    Returns (status, details):
      status: "ok" | "missing_in_shared" | "drift" | "violation"
      details: list of (relative_subpath, kind) pairs, kind in
        {"missing_in_tools", "drift", "violation"}; empty for ok/missing_in_shared.

    "drift" means tools is behind shared but every differing byte-for-byte
    version it holds legitimately existed in shared's recent history (or
    tools is simply missing the file) -- safe to copy shared -> tools.
    "violation" means at least one file's tools-side content was never, in
    the lookback window, a real relationship-shared version of that path --
    it was edited directly in tools and must not be silently overwritten.
    """
    days = cfg.get("mirror_violation_lookback_days", 30)
    src = SHARED / item["shared_rel"]
    dst = TOOLS / item["tools_rel"]
    if not src.exists():
        return "missing_in_shared", []

    if item["is_dir"]:
        diffs = list(dir_file_diffs(src, dst))
        if not diffs:
            return "ok", []
        details = []
        for rel in diffs:
            d = dst / rel
            if not d.is_file():
                details.append((rel, "missing_in_tools"))
                continue
            shared_rel_path = f"{item['shared_rel']}/{rel.as_posix()}"
            if mirror_content_is_legitimate(shared_rel_path, d.read_bytes(), days):
                details.append((rel, "drift"))
            else:
                details.append((rel, "violation"))
        status = "violation" if any(k == "violation" for _, k in details) else "drift"
        return status, details

    if not dst.is_file():
        return "drift", [(Path("."), "missing_in_tools")]
    if src.read_bytes() == dst.read_bytes():
        return "ok", []
    if mirror_content_is_legitimate(item["shared_rel"], dst.read_bytes(), days):
        return "drift", [(Path("."), "drift")]
    return "violation", [(Path("."), "violation")]


def check_consistency(cfg, verbose=False):
    if not SHARED.exists():
        print(c(YELLOW, "  [skip] shared repo not found"))
        return True
    all_ok = True
    days = cfg.get("mirror_violation_lookback_days", 30)
    for item in cfg["mirror_items"]:
        label = item["tools_rel"]
        status, details = classify_mirror_item(item, cfg)
        if status == "missing_in_shared":
            print(c(YELLOW, f"  [warn] missing in shared: {item['shared_rel']}"))
            continue
        if status == "ok":
            print(c(GREEN, f"  [ok] {label}"))
            continue
        if status == "drift":
            print(c(RED, f"  [drift] {label}"))
            if verbose:
                for rel, kind in details:
                    print(f"    {rel}: {kind}")
            all_ok = False
            continue
        print(c(RED + BOLD, f"  [violation] {label}"))
        for rel, kind in details:
            if kind == "violation":
                print(c(RED, f"    {rel}: content not found in relationship-shared's last {days}d of history -- hand-edited in tools?"))
            elif verbose:
                print(f"    {rel}: {kind}")
        all_ok = False
    return all_ok


def iter_mirror_files(cfg):
    for item in cfg["mirror_items"]:
        dst = TOOLS / item["tools_rel"]
        if not dst.exists():
            continue
        for f in (collect_files(dst) if item["is_dir"] else [dst]):
            if f.is_file():
                yield f


def check_portability(cfg, verbose=False):
    compiled = compile_patterns(cfg["internal_patterns"])
    all_ok = True
    for f in iter_mirror_files(cfg):
        rel = f.relative_to(TOOLS)
        hits = grep_patterns(f, compiled)
        if hits:
            print(c(RED, f"  [leak] {rel}"))
            for ln, line, label in hits[:10]:
                print(f"    L{ln} [{label}]: {line[:120]}")
            all_ok = False
        elif verbose:
            print(c(GREEN, f"  [ok] {rel}"))
    return all_ok


def check_ref_integrity(cfg, verbose=False):
    compiled = compile_patterns(cfg["ref_integrity_patterns"])
    path_compiled = compile_patterns(cfg["ref_integrity_path_patterns"])
    exempt = set(cfg["ref_integrity_exempt"])
    all_ok = True
    for f in iter_mirror_files(cfg):
        rel = str(f.relative_to(TOOLS))
        if rel in exempt:
            if verbose:
                print(c(GREEN, f"  [ok] {rel} (exempt)"))
            continue
        raw = grep_patterns(f, compiled) + grep_patterns(f, path_compiled, skip_url_lines=True)
        dedup = {}
        for hit in raw:
            dedup.setdefault(hit[0], hit)
        hits = [dedup[k] for k in sorted(dedup.keys())]
        if hits:
            print(c(YELLOW, f"  [ref?] {rel}"))
            for ln, line, label in hits[:10]:
                print(f"    L{ln} [{label}]: {line[:120]}")
            all_ok = False
        elif verbose:
            print(c(GREEN, f"  [ok] {rel}"))
    return all_ok


def check_personal_only(cfg):
    all_ok = True
    for rel in sorted(cfg["personal_only"]):
        dst = TOOLS / rel
        if not dst.exists():
            print(c(YELLOW, f"  [warn] missing personal-only item: {rel}"))
            continue
        if SHARED.exists() and (SHARED / rel).exists():
            print(c(RED, f"  [leak] personal-only found in shared: {rel}"))
            all_ok = False
        else:
            print(c(GREEN, f"  [ok] {rel}"))
    return all_ok


def do_sync(cfg, dry_run=False):
    if not SHARED.exists():
        print(c(RED, "ERROR: --sync requires ~/src/relationship-shared"))
        return False
    if not block_if_managed_changes(cfg, "sync"):
        return False
    print(c(CYAN, f"Pre-sync pull sequence: shared, then {TOOLS_REPO_LABEL}"))
    if not pull_repo(SHARED, "~/src/relationship-shared", cfg=cfg, check_managed_only=True):
        return False
    if not pull_repo(TOOLS, TOOLS_REPO_LABEL):
        return False

    changed = []
    violations = []
    days = cfg.get("mirror_violation_lookback_days", 30)
    for item in cfg["mirror_items"]:
        label = item["tools_rel"]
        status, details = classify_mirror_item(item, cfg)
        if status == "missing_in_shared":
            print(c(YELLOW, f"  [skip] missing in shared: {item['shared_rel']}"))
            continue
        if status == "ok":
            print(f"  [=] {label}")
            continue
        if status == "violation":
            violations.append(label)
            print(c(RED + BOLD, f"  [violation] {label} -- refusing to overwrite"))
            for rel, kind in details:
                if kind == "violation":
                    print(c(RED, f"    {rel}: content not found in relationship-shared's last {days}d of history -- hand-edited in tools?"))
            continue
        # status == "drift": safe to copy shared -> tools
        changed.append(label)
        print(c(YELLOW, f"  [→] {label}") + (" (would copy)" if dry_run else " (copying)"))
        if dry_run:
            continue
        src = SHARED / item["shared_rel"]
        dst = TOOLS / item["tools_rel"]
        dst.parent.mkdir(parents=True, exist_ok=True)
        if item["is_dir"]:
            if dst.exists():
                shutil.rmtree(dst)
            shutil.copytree(src, dst)
        else:
            shutil.copy2(src, dst)

    if violations:
        print()
        print(c(RED + BOLD, f"⚠ {len(violations)} mirror item(s) have content not traceable to relationship-shared's last {days} days -- sync aborted for those items."))
        print(c(RED, "Do not blindly overwrite; investigate manually:"))
        for label in violations:
            print(f"  - {label}")
        return False

    if dry_run or not changed:
        return True

    print()
    print(c(CYAN, "Rechecking portability on changed items…"))
    compiled = compile_patterns(cfg["internal_patterns"])
    leak = False
    for rel in changed:
        p = TOOLS / rel
        files = collect_files(p) if p.is_dir() else [p]
        for f in files:
            if not f.is_file():
                continue
            hits = grep_patterns(f, compiled)
            if hits:
                leak = True
                show = str(f.relative_to(TOOLS))
                print(c(RED, f"  [leak] {show}"))
                for ln, line, label in hits[:10]:
                    print(f"    L{ln} [{label}]: {line[:120]}")
    if leak:
        print(c(RED, "Portability check failed after sync; do not commit yet."))
        return False
    print(c(GREEN, "Portability clean on synced changes."))
    return True


def do_push(cfg):
    if not SHARED.exists():
        print(c(RED, "ERROR: --push requires ~/src/relationship-shared"))
        return False
    if not block_if_managed_changes(cfg, "push"):
        return False

    remote, branch = detect_upstream(TOOLS)
    ahead_r = run_git(TOOLS, "rev-list", "--count", "HEAD@{upstream}..HEAD")
    if ahead_r.returncode != 0:
        print(c(RED, "Cannot determine upstream; set one first."))
        return False
    ahead = int(ahead_r.stdout.strip() or "0")
    if ahead == 0:
        print(c(YELLOW, "Nothing to push."))
        return True

    exempt = set(cfg["portability_push_exempt"])
    compiled = compile_patterns(cfg["internal_patterns"])
    diff_r = run_git(TOOLS, "diff", "-U0", "HEAD@{upstream}..HEAD")
    leaks = []
    current_file = "(unknown)"
    skip = False
    for line in diff_r.stdout.splitlines():
        if line.startswith("+++ b/"):
            current_file = line[6:]
            skip = current_file in exempt
            continue
        if skip or not line.startswith("+") or line.startswith("+++"):
            continue
        content = line[1:]
        for rx, label in compiled:
            if rx.search(content):
                leaks.append((current_file, content.rstrip(), label))
                break

    if leaks:
        print(c(RED + BOLD, "Portability push gate failed; refusing push."))
        for fp, line, label in leaks[:20]:
            print(c(RED, f"  [{label}] {fp}"))
            print(f"    {line[:120]}")
        return False

    print(c(CYAN, f"Pushing {TOOLS_REPO_LABEL} to {remote}/{branch}…"))
    r = run_git(TOOLS, "push", remote, branch, capture=False)
    if r.returncode != 0:
        print(c(RED + BOLD, "Push failed."))
        return False
    print(c(GREEN + BOLD, "Push succeeded."))
    return True


def run_audit(cfg, args):
    run_all = not any([args.consistency, args.portability, args.ref_integrity, args.personal_only])
    results = []
    if run_all or args.consistency:
        print(c(BOLD, "── Consistency"))
        results.append(check_consistency(cfg, verbose=args.verbose))
    if run_all or args.portability:
        print(c(BOLD, "── Portability"))
        results.append(check_portability(cfg, verbose=args.verbose))
    if run_all or args.ref_integrity:
        print(c(BOLD, "── Ref-integrity"))
        results.append(check_ref_integrity(cfg, verbose=args.verbose))
    if run_all or args.personal_only:
        print(c(BOLD, "── Personal-only"))
        results.append(check_personal_only(cfg))
    ok = all(results) if results else True
    print()
    print(c((GREEN if ok else RED) + BOLD, "✓ All checks passed" if ok else "✗ One or more checks failed"))
    return ok


def parse_args():
    p = argparse.ArgumentParser(
        description="Audit/sync ~/src/tools mirror; push on work laptop, pull on personal"
    )
    p.add_argument("--consistency", action="store_true")
    p.add_argument("--portability", action="store_true")
    p.add_argument("--ref-integrity", action="store_true")
    p.add_argument("--personal-only", action="store_true")
    p.add_argument("--sync", action="store_true")
    p.add_argument("--push", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("-v", "--verbose", action="store_true")
    return p.parse_args()


def main():
    cfg = load_cfg()
    args = parse_args()
    on_work = SHARED.exists()

    if args.push:
        sys.exit(0 if do_push(cfg) else 1)

    if args.sync:
        sys.exit(0 if do_sync(cfg, dry_run=args.dry_run) else 1)

    explicit_audit = any([args.consistency, args.portability, args.ref_integrity, args.personal_only])
    if not on_work and not explicit_audit:
        if not block_if_managed_changes(cfg, "pull"):
            sys.exit(1)
        sys.exit(0 if pull_repo(TOOLS, TOOLS_REPO_LABEL) else 1)

    sys.exit(0 if run_audit(cfg, args) else 1)


if __name__ == "__main__":
    main()
