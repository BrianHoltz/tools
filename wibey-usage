// ── Token Type Cost Doughnut ─────────────────────────────────────────────
function renderTokenTypeCostChart(daily) {
  destroyChart('tokenTypeCost');
  // Compute cost per token type across all filtered daily data, using per-model pricing
  let inputCost = 0, outputCost = 0, cacheReadCost = 0, cacheWriteCost = 0;
  daily.forEach(r => {
    const p = getPricing(r.model);
    inputCost += (r.input_tokens || 0) * p.input / 1e6;
    outputCost += (r.output_tokens || 0) * p.output / 1e6;
    cacheReadCost += (r.cache_read || 0) * p.cache_read / 1e6;
    cacheWriteCost += (r.cache_creation || 0) * p.cache_create / 1e6;
  });

  const types = [
    { label: 'Input', cost: inputCost },
    { label: 'Output', cost: outputCost },
    { label: 'Cache Read', cost: cacheReadCost },
    { label: 'Cache Write', cost: cacheWriteCost },
  ].filter(t => t.cost > 0);
  const totalCost = types.reduce((a, t) => a + t.cost, 0);

  charts.tokenTypeCost = new Chart(document.getElementById('tokenTypeCostChart'), {
    type: 'doughnut',
    data: {
      labels: types.map(t => t.label),
      datasets: [{
        data: types.map(t => t.cost),
        backgroundColor: types.map(t => TOKEN_TYPE_COLORS[t.label] || DEFAULT_COLOR),
        borderWidth: 0,
      }],
    },
    options: {
      responsive: true, cutout: '55%',
      plugins: {
        legend: { position: 'bottom', labels: { color: '#8b949e', padding: 10, font: { size: 11 } } },
        tooltip: {
          callbacks: {
            label: ctx => {
              const pct = totalCost ? (ctx.raw / totalCost * 100).toFixed(1) + '%' : '0%';
              return ctx.label + ': ' + fmtCost(ctx.raw) + ' (' + pct + ')';
            }
          }
        },
      },
    },
  });
}

