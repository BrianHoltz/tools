  // Get top 8 tools by total calls, group rest as "Other"
  const toolTotals = {};
  dt.forEach(r => { toolTotals[r.tool_name] = (toolTotals[r.tool_name]||0) + r.calls; });
  const topTools = Object.entries(toolTotals).sort((a,b) => b[1]-a[1]).slice(0, 8).map(([n]) => n);
