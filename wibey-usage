// ── Cache Efficiency Over Time ──────────────────────────────────────────
function renderCacheChart(daily) {
  destroyChart('cache');
  const byDay = {};
  daily.forEach(r => {
    if (!byDay[r.day]) byDay[r.day] = { input: 0, cacheRead: 0, cacheCreate: 0 };
    byDay[r.day].input += r.input_tokens || 0;
    byDay[r.day].cacheRead += r.cache_read || 0;
    byDay[r.day].cacheCreate += r.cache_creation || 0;
  });
  const days = Object.keys(byDay).sort();

  charts.cache = new Chart(document.getElementById('cacheChart'), {
    type: 'line',
    data: {
      labels: days,
      datasets: [
        {
          label: 'Cache Hit Rate',
          data: days.map(d => {
            const total = byDay[d].input + byDay[d].cacheRead + byDay[d].cacheCreate;
            return total ? byDay[d].cacheRead / total : 0;
          }),
          borderColor: '#f778ba', backgroundColor: 'rgba(247,120,186,0.1)',
          fill: true, tension: 0.3, pointRadius: 2, yAxisID: 'y',
        },
        {
          label: 'Cache Savings ($)',
          data: days.map(d => {
            // Savings = what cache reads would have cost at full input price minus cache read price
            // Rough estimate using avg $4/1M input vs $0.4/1M cache read
            return byDay[d].cacheRead * (4.0 - 0.4) / 1e6;
          }),
          borderColor: '#3fb950', backgroundColor: 'rgba(63,185,80,0.1)',
          fill: false, tension: 0.3, pointRadius: 2, yAxisID: 'y1',
        },
      ],
    },
    options: {
      responsive: true,
      plugins: { legend: { labels: { color: '#8b949e', font: { size: 11 } } },
        tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ' + (ctx.datasetIndex === 0 ? fmtPct(ctx.raw) : fmtCost(ctx.raw)) } },
      },
      scales: {
        x: { ticks: { color: '#8b949e', maxRotation: 45 }, grid: { color: '#21262d' } },
        y: { position: 'left', ticks: { color: '#f778ba', callback: v => fmtPct(v) }, grid: { color: '#21262d' }, min: 0, max: 1 },
        y1: { position: 'right', ticks: { color: '#3fb950', callback: v => '$'+v.toFixed(0) }, grid: { display: false } },
      },
    },
  });
}

