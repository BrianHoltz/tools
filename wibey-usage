# ── Main ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="wibey-usage",
        description="Wibey local token usage tracker and dashboard",
    )
    sub = parser.add_subparsers(dest="command")

    # report
    rp = sub.add_parser("report", help="Terminal usage report")
    rp.add_argument("--days", type=int, help="Limit to last N days")

    # export
    ep = sub.add_parser("export", help="Export usage data")
    ep.add_argument("--csv", action="store_true", default=True, help="Export as CSV (default)")
    ep.add_argument("--json", action="store_true", help="Export as JSON")
    ep.add_argument("--output", "-o", help="Output file path")

    # dash
    dp = sub.add_parser("dash", help="Generate and open HTML dashboard")
    dp.add_argument("--output", "-o", help="Output HTML file path")
    dp.add_argument(
        "--no-open", action="store_true",
        help="Regenerate the dashboard file without opening a browser tab "
             "(for cron / headless runs). BUG FIX 2026-08-10: the hourly "
             "crontab entry has been passing this flag since it was set up, "
             "but argparse never accepted it — every cron run failed with "
             "'unrecognized arguments: --no-open' (see /tmp/wibey-dash-cron.log). "
             "The dashboard was therefore only ever regenerated by manual runs.",
    )

    # skills
    sp = sub.add_parser("skills", help="Skill usage report")
    sp.add_argument("--days", type=int, help="Limit to last N days")

    # tools
    tp = sub.add_parser("tools", help="Tool usage report")
    tp.add_argument("--days", type=int, help="Limit to last N days")

    # backfill
    bp = sub.add_parser("backfill", help="Backfill from historical transcripts")
    bp.add_argument("--include-agents", action="store_true",
                     help="Include subagent transcripts")

    # calibrate
    cp = sub.add_parser("calibrate", help="Calibrate weekly $ limit from Wibey UI quota %%")
    cp.add_argument("--pct", type=float, required=True,
                     help="Percent used shown in Wibey UI quota widget (e.g. 49)")

    args = parser.parse_args()

    if args.command == "export":
        cmd_export(args)
    elif args.command == "dash":
        cmd_dash(args)
    elif args.command == "skills":
        cmd_skills(args)
    elif args.command == "tools":
        cmd_tools(args)
    elif args.command == "backfill":
        cmd_backfill(args)
    elif args.command == "calibrate":
        cmd_calibrate(args)
    else:
        # Default: show report
        if not hasattr(args, "days"):
            args.days = None
        cmd_report(args)


if __name__ == "__main__":
    main()
