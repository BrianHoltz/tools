const allModels = [...new Set(RAW.sessions.flatMap(s => (s.models||'').split(',').filter(Boolean)))].sort();
const projSelect = document.getElementById('filterProject');
const modelSelect = document.getElementById('filterModel');
allProjects.forEach(p => { const o = document.createElement('option'); o.value = p; o.textContent = p; projSelect.appendChild(o); });
allModels.forEach(m => { const o = document.createElement('option'); o.value = m; o.textContent = m; modelSelect.appendChild(o); });

// Set default date range to last 30 days
const now = new Date();
const d30 = new Date(now); d30.setDate(d30.getDate() - 30);
document.getElementById('dateFrom').value = d30.toISOString().split('T')[0];
document.getElementById('dateTo').value = now.toISOString().split('T')[0];
state.dateFrom = d30.toISOString().split('T')[0];
state.dateTo = now.toISOString().split('T')[0];

// ── Filter logic ────────────────────────────────────────────────────────
function filterSessions() {
  return RAW.sessions.filter(s => {
    const day = dayStr(s.ended_at);
    if (state.dateFrom && day && day < state.dateFrom) return false;
    if (state.dateTo && day && day > state.dateTo) return false;
    if (state.project && s.project !== state.project) return false;
    if (state.model && !(s.models||'').includes(state.model)) return false;
    return true;
  });
}

function filterDaily() {
  return RAW.daily.filter(r => {
    if (state.dateFrom && r.day < state.dateFrom) return false;
    if (state.dateTo && r.day > state.dateTo) return false;
    if (state.model && r.model !== state.model) return false;
    return true;
  });
}

function searchSessions(sessions) {
  if (!state.search) return sessions;
  const q = state.search.toLowerCase();
  return sessions.filter(s =>
    (s.project||'').toLowerCase().includes(q) ||
    (s.git_branch||'').toLowerCase().includes(q) ||
    (s.models||'').toLowerCase().includes(q) ||
    (s.reason||'').toLowerCase().includes(q) ||
    (s.session_id||'').toLowerCase().includes(q)
  );
}

// ── Render everything ───────────────────────────────────────────────────
function render() {
  const sessions = filterSessions();
  const daily = filterDaily();

  renderCards(sessions);
  renderWorkWeekCost(RAW.work_week_hourly || [], RAW.weekly_limit || 150, RAW.code_puppy_quota_series || [], RAW.code_puppy_reset_anchor || null);
  renderDailyCost(daily);
  renderModelChart(sessions);
  renderTokenTypeCostChart(daily);
