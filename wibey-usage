def get_conn() -> sqlite3.Connection:
    conn = init_db()
    conn.row_factory = sqlite3.Row
    return conn


# ── Quota Calibration ────────────────────────────────────────────────────────
# Local token counts do not line up with Wibey's internal weekly-quota
# formula (verified 2026-08-07: local said 35% of 15M tokens used while the
# Wibey UI widget said 49% used, at essentially the same moment — the two
# don't reconcile via any simple token-weighting we tried). Rather than
# guess, calibrate directly against a (%, $cost) point read off the Wibey
# UI: weekly_limit_dollars = cost_so_far_this_week / pct_used.

CALIBRATION_PATH = Path.home() / ".wibey" / "usage" / "quota_calibration.json"


def get_weekly_limit(monday_date, week_cost_so_far: float) -> float:
    """Return the $ equivalent of the weekly token quota, from calibration
    if one exists for the current week, else a rough fallback."""
    if CALIBRATION_PATH.exists():
        try:
            cal = json.loads(CALIBRATION_PATH.read_text())
            if cal.get("week_start") == monday_date.isoformat() and cal.get("pct_used"):
                return cal["cost_at_capture"] / cal["pct_used"]
        except (json.JSONDecodeError, KeyError, ZeroDivisionError, TypeError):
            pass
    # Fallback: no calibration for this week yet. Always use fixed limit.
    # Early-week spending is not predictive (may be 2-3% by Monday, not 35%).
    # Require explicit calibration: wibey-usage calibrate --pct N
    return 650.0


def cmd_calibrate(args):
    """Record a (%, $cost) calibration point from the Wibey UI quota widget."""
    conn = get_conn()
    today = datetime.now().date()
    monday = today - timedelta(days=today.weekday())
    monday_dt = datetime.combine(monday, datetime.min.time())

    row = conn.execute("""
        SELECT SUM(cost_usd) as cost FROM token_usage
        WHERE LENGTH(COALESCE(usage_date, '')) = 16
          AND usage_date >= ? AND usage_date < ?
    """, (monday.isoformat(), (monday + timedelta(days=7)).isoformat())).fetchone()
    cost_so_far = row["cost"] or 0.0
    conn.close()

    pct = args.pct / 100.0 if args.pct > 1 else args.pct
    CALIBRATION_PATH.parent.mkdir(parents=True, exist_ok=True)
    CALIBRATION_PATH.write_text(json.dumps({
        "week_start": monday.isoformat(),
        "pct_used": pct,
        "cost_at_capture": cost_so_far,
        "captured_at": datetime.now(timezone.utc).isoformat(),
    }, indent=2))

    weekly_limit = cost_so_far / pct if pct else 0.0
    print(f"Calibrated: {pct*100:.0f}% used == ${cost_so_far:.2f} local cost so far this week")
    print(f"Implied weekly limit: ${weekly_limit:.2f}")
    print(f"Saved to {CALIBRATION_PATH}")


# ── Terminal Report ──────────────────────────────────────────────────────────

def cmd_report(args):
    conn = get_conn()

    where = ""
    params = []
    if args.days:
        cutoff = (datetime.now(timezone.utc) - timedelta(days=args.days)).isoformat()
        where = "WHERE s.ended_at >= ?"
        params = [cutoff]

    # Summary
    row = conn.execute(f"""
        SELECT
            COUNT(DISTINCT s.session_id) as sessions,
            COALESCE(SUM(t.input_tokens), 0) as input_tok,
            COALESCE(SUM(t.output_tokens), 0) as output_tok,
            COALESCE(SUM(t.cache_read), 0) as cache_read,
            COALESCE(SUM(t.cache_creation), 0) as cache_create,
            COALESCE(SUM(t.cost_usd), 0) as total_cost,
            COALESCE(SUM(s.duration_secs), 0) as total_duration,
            COALESCE(SUM(s.message_count), 0) as total_messages
        FROM sessions s
        LEFT JOIN token_usage t ON s.session_id = t.session_id
        {where}
    """, params).fetchone()

    period = f"last {args.days} days" if args.days else "all time"
    now = datetime.now().strftime("%Y.%m.%d")
    print(f"\n{'═' * 60}")
    print(f"  WIBEY USAGE REPORT — {period} ({now})")
    print(f"{'═' * 60}")
    print(f"  Sessions:      {row['sessions']:>10,}")
    print(f"  Messages:      {row['total_messages']:>10,}")
    print(f"  Duration:      {format_duration(row['total_duration']):>10}")
    cost_str = f"${row['total_cost']:.2f}"
    print(f"  Total Cost:    {cost_str:>10}")
    print(f"{'─' * 60}")
    print(f"  Input Tokens:  {row['input_tok']:>14,}")
    print(f"  Output Tokens: {row['output_tok']:>14,}")
    print(f"  Cache Read:    {row['cache_read']:>14,}")
    print(f"  Cache Create:  {row['cache_create']:>14,}")

    # Per-model breakdown
    models = conn.execute(f"""
        SELECT
            t.model,
            SUM(t.input_tokens) as input_tok,
            SUM(t.output_tokens) as output_tok,
            SUM(t.cache_read) as cache_read,
            SUM(t.cache_creation) as cache_create,
            SUM(t.cost_usd) as cost
        FROM token_usage t
        JOIN sessions s ON s.session_id = t.session_id
        {where}
        GROUP BY t.model
        ORDER BY cost DESC
    """, params).fetchall()

    if models:
        print(f"\n{'─' * 60}")
        print(f"  {'MODEL':<25} {'TOKENS':>12} {'COST':>10}")
        print(f"  {'─' * 25} {'─' * 12} {'─' * 10}")
        for m in models:
            total_tok = m["input_tok"] + m["output_tok"]
            print(f"  {m['model']:<25} {total_tok:>12,} ${m['cost']:>8.2f}")

    # Daily breakdown (last 14 days or requested)
    daily = conn.execute(f"""
        SELECT
            COALESCE(t.usage_date, DATE(s.ended_at)) as day,
            COUNT(DISTINCT s.session_id) as sessions,
            SUM(t.cost_usd) as cost,
            SUM(t.input_tokens + t.output_tokens) as tokens
        FROM sessions s
        LEFT JOIN token_usage t ON s.session_id = t.session_id
        WHERE LENGTH(COALESCE(t.usage_date, '')) = 10
        {" AND " + where.replace('s.ended_at', 's.ended_at') if where else ""}
        GROUP BY COALESCE(t.usage_date, DATE(s.ended_at))
        ORDER BY day DESC
        LIMIT 14
    """, params).fetchall()

    if daily:
        print(f"\n{'─' * 60}")
        print(f"  {'DATE':<12} {'SESSIONS':>8} {'TOKENS':>12} {'COST':>10}")
        print(f"  {'─' * 12} {'─' * 8} {'─' * 12} {'─' * 10}")
        for d in daily:
            print(f"  {d['day']:<12} {d['sessions']:>8} {(d['tokens'] or 0):>12,} ${(d['cost'] or 0):>8.2f}")

    # Top projects
    projects = conn.execute(f"""
        SELECT
            s.project,
            COUNT(DISTINCT s.session_id) as sessions,
            SUM(t.cost_usd) as cost
        FROM sessions s
        LEFT JOIN token_usage t ON s.session_id = t.session_id
        {where}
        GROUP BY s.project
        ORDER BY cost DESC
        LIMIT 10
    """, params).fetchall()

    if projects:
        print(f"\n{'─' * 60}")
        print(f"  {'PROJECT':<40} {'SESS':>5} {'COST':>10}")
        print(f"  {'─' * 40} {'─' * 5} {'─' * 10}")
        for p in projects:
            name = shorten_project(p["project"]) if p["project"] else "(unknown)"
            print(f"  {name:<40} {p['sessions']:>5} ${(p['cost'] or 0):>8.2f}")

    print(f"\n{'═' * 60}\n")
    conn.close()


