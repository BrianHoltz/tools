// ── Cards ───────────────────────────────────────────────────────────────
function renderCards(sessions) {
  const totIn = sessions.reduce((a, s) => a + (s.input_tok||0), 0);
  const totOut = sessions.reduce((a, s) => a + (s.output_tok||0), 0);
  const totCR = sessions.reduce((a, s) => a + (s.cache_read||0), 0);
  const totCC = sessions.reduce((a, s) => a + (s.cache_create||0), 0);
  const totCost = sessions.reduce((a, s) => a + (s.cost||0), 0);
  const totDur = sessions.reduce((a, s) => a + (s.duration_secs||0), 0);
  const totMsg = sessions.reduce((a, s) => a + (s.message_count||0), 0);
  const ioRatio = totOut ? (totIn / totOut) : 0;
  const cacheHitRate = (totIn + totCR + totCC) ? totCR / (totIn + totCR + totCC) : 0;
  const costPerMsg = totMsg ? totCost / totMsg : 0;
  const avgCost = sessions.length ? totCost / sessions.length : 0;

  document.getElementById('subtitle').textContent =
    (state.dateFrom || '?') + ' \u2192 ' + (state.dateTo || '?') +
    ' \u00b7 ' + sessions.length + ' sessions \u00b7 Generated ' + RAW.generated_at.split('T')[0];

  document.getElementById('cards').innerHTML = `
    <div class="card"><div class="label">Total Cost</div><div class="value cost">${fmtCost(totCost)}</div><div class="sub">Avg ${fmtCost(avgCost)}/session</div></div>
    <div class="card"><div class="label">Sessions</div><div class="value sessions">${fmt(sessions.length)}</div><div class="sub">${fmt(totMsg)} messages</div></div>
    <div class="card"><div class="label">Input Tokens</div><div class="value tokens">${fmt(totIn)}</div><div class="sub">${fmtPct(totIn/(totIn+totOut||1))} of I/O</div></div>
    <div class="card"><div class="label">Output Tokens</div><div class="value tokens">${fmt(totOut)}</div><div class="sub">${fmtPct(totOut/(totIn+totOut||1))} of I/O</div></div>
    <div class="card"><div class="label">I/O Ratio</div><div class="value ratio">${ioRatio.toFixed(2)}:1</div><div class="sub">${fmt(totIn)} in / ${fmt(totOut)} out</div></div>
    <div class="card"><div class="label">Cache Hit Rate</div><div class="value cache">${fmtPct(cacheHitRate)}</div><div class="sub">${fmt(totCR)} cache reads</div></div>
    <div class="card"><div class="label">Total Time</div><div class="value time">${fmtDur(totDur)}</div><div class="sub">$/hr: ${fmtCost(totDur > 0 ? totCost/(totDur/3600) : 0)}</div></div>
    <div class="card"><div class="label">Cost per Message</div><div class="value cost">${fmtCost(costPerMsg)}</div><div class="sub">${fmt(totMsg)} total messages</div></div>
  `;
}


