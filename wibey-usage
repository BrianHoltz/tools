const tbody = document.querySelector('#sessionsTable tbody');
let sortCol = 'ended_at', sortDir = -1;

function renderTable(sessions) {
  const sorted = [...sessions].sort((a, b) => {
    let va = a[sortCol], vb = b[sortCol];
    if (sortCol === 'io_ratio') { va = (a.output_tok ? a.input_tok/a.output_tok : 0); vb = (b.output_tok ? b.input_tok/b.output_tok : 0); }
    if (sortCol === 'cpm') { va = (a.message_count ? a.cost/a.message_count : 0); vb = (b.message_count ? b.cost/b.message_count : 0); }
    if (typeof va === 'string' && typeof vb === 'string') return sortDir * va.localeCompare(vb);
    return sortDir * ((va || 0) - (vb || 0));
  });

  // Pagination
  const totalPages = Math.ceil(sorted.length / PAGE_SIZE);
  const page = Math.min(state.page, totalPages - 1);
  const paged = sorted.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE);

  document.getElementById('tableCount').textContent = sorted.length + ' sessions';

  tbody.innerHTML = paged.map(s => {
    const tag = s.reason === 'exit' ? 'exit' : s.reason === 'clear' ? 'clear' : s.reason === 'backfill' ? 'backfill' : 'other';
    const inPct = (s.input_tok + s.output_tok) ? Math.round(s.input_tok / (s.input_tok + s.output_tok) * 100) : 50;
    const ioR = s.output_tok ? (s.input_tok / s.output_tok) : 0;
    const cpm = s.message_count ? s.cost / s.message_count : 0;
    return '<tr>' +
      '<td class="mono">' + (s.ended_at ? s.ended_at.split('T')[0] + ' ' + (s.ended_at.split('T')[1]||'').slice(0,5) : '\u2014') + '</td>' +
      '<td>' + (s.project || '\u2014') + '</td>' +
      '<td class="mono" style="font-size:11px">' + (s.models || '\u2014') + '</td>' +
      '<td><span class="tag tag-' + tag + '">' + (s.reason || '\u2014') + '</span></td>' +
      '<td class="right">' + fmt(s.message_count) + '</td>' +
      '<td class="right">' + fmtDur(s.duration_secs) + '</td>' +
      '<td class="right mono">' + fmt(s.input_tok) + '</td>' +
      '<td class="right mono">' + fmt(s.output_tok) + '</td>' +
      '<td class="right"><span class="ratio-bar" style="--in-pct:' + inPct + '%"></span><span class="mono" style="font-size:11px">' + ioR.toFixed(1) + ':1</span></td>' +
      '<td class="right mono" style="color:var(--green)">' + fmtCost(s.cost) + '</td>' +
      '<td class="right mono" style="font-size:11px;color:var(--orange)">' + fmtCost(cpm) + '</td>' +
    '</tr>';
  }).join('');

  // Pagination controls
  const pag = document.getElementById('pagination');
  if (totalPages <= 1) { pag.innerHTML = ''; return; }
  pag.innerHTML =
    '<button id="prevPage" ' + (page <= 0 ? 'disabled' : '') + '>\u25C0 Prev</button>' +
    '<span>Page ' + (page+1) + ' of ' + totalPages + '</span>' +
    '<button id="nextPage" ' + (page >= totalPages-1 ? 'disabled' : '') + '>Next \u25B6</button>';
  document.getElementById('prevPage').onclick = () => { state.page = Math.max(0, page-1); render(); };
  document.getElementById('nextPage').onclick = () => { state.page = Math.min(totalPages-1, page+1); render(); };

  // Sort indicators
  document.querySelectorAll('#sessionsTable th').forEach(th => {
    th.classList.remove('sorted-asc', 'sorted-desc');
    if (th.dataset.col === sortCol) th.classList.add(sortDir === 1 ? 'sorted-asc' : 'sorted-desc');
  });
}

