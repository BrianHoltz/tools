# ── Export ───────────────────────────────────────────────────────────────────

def cmd_export(args):
    conn = get_conn()
    rows = conn.execute("""
        SELECT
            s.session_id, s.project, s.git_branch, s.reason,
            s.started_at, s.ended_at, s.duration_secs, s.message_count,
            t.model, t.input_tokens, t.output_tokens,
            t.cache_read, t.cache_creation, t.cost_usd
        FROM sessions s
        LEFT JOIN token_usage t ON s.session_id = t.session_id
        ORDER BY s.ended_at DESC
    """).fetchall()

    if args.json:
        data = [dict(r) for r in rows]
        out = args.output or "wibey-usage-export.json"
        with open(out, "w") as f:
            json.dump(data, f, indent=2)
        print(f"Exported {len(data)} rows to {out}")
    else:
        out = args.output or "wibey-usage-export.csv"
        with open(out, "w", newline="") as f:
            writer = csv.writer(f)
            writer.writerow(rows[0].keys() if rows else [])
            for r in rows:
                writer.writerow(tuple(r))
        print(f"Exported {len(rows)} rows to {out}")

    conn.close()


# ── Dashboard ────────────────────────────────────────────────────────────────

def cmd_dash(args):
    conn = get_conn()

    # Best-effort live snapshot of Code Puppy's own 6h rolling quota.
    # puppy-backend keeps no history, so this hourly cron call (see crontab)
    # is the only source of the time series rendered as an overlay below.
    # Fails silently — never blocks dashboard generation.
    code_puppy_quota_now = log_code_puppy_quota(conn)

    # Gather all data for the dashboard
    daily = conn.execute("""
        SELECT
            SUBSTRING(COALESCE(t.usage_date, DATE(s.ended_at)), 1, 10) as day,
            t.model,
            COUNT(DISTINCT s.session_id) as sessions,
            SUM(t.input_tokens) as input_tokens,
            SUM(t.output_tokens) as output_tokens,
            SUM(t.cache_read) as cache_read,
            SUM(t.cache_creation) as cache_creation,
            SUM(t.cost_usd) as cost
        FROM sessions s
        JOIN token_usage t ON s.session_id = t.session_id
        WHERE s.ended_at IS NOT NULL
        GROUP BY SUBSTRING(COALESCE(t.usage_date, DATE(s.ended_at)), 1, 10), t.model
        ORDER BY day
    """).fetchall()

    # Gather 5-minute bucket data for the full work week (Mon 00:00 UTC -> now)
    # Fine-grained view for real-time monitoring of quota consumption
    from datetime import date, timedelta
    today = date.today()
    monday = today - timedelta(days=today.weekday())
    week_end_dt = monday + timedelta(days=7)
    now_utc = datetime.now(timezone.utc).replace(tzinfo=None)

    fine_grain = conn.execute(f"""
        SELECT
            t.usage_date as bucket,
            t.model,
            SUM(t.input_tokens) as input_tokens,
            SUM(t.output_tokens) as output_tokens,
            SUM(t.cache_read) as cache_read,
            SUM(t.cache_creation) as cache_creation,
            SUM(t.cost_usd) as cost
        FROM token_usage t
        WHERE LENGTH(COALESCE(t.usage_date, '')) = 16
          AND t.usage_date >= '{monday.isoformat()}'
          AND t.usage_date < '{week_end_dt.isoformat()}'
        GROUP BY t.usage_date, t.model
        ORDER BY bucket
    """).fetchall()

    # Work-week cumulative cost: DENSE 5-minute grid, Mon 9am UTC -> now,
    # zero-filled so gaps render as flat cumulative regions instead of jumping.
    # Mon 9am UTC ≈ Mon 2am PST, but we want Mon 9am PST = Mon 4pm UTC previous day.
    # Simpler: start from Monday 00:00 UTC and skip to first 9am PST bucket.
    monday = today - timedelta(days=today.weekday())
    monday_dt = datetime.combine(monday, datetime.min.time())
    # Mon 9am PST = Mon 17:00 UTC (UTC+8 during daylight, but we use -7 offset)
    # Actually PST in summer is UTC-7, so 9am PST = 4pm UTC same day
    monday_9am_pst_utc = monday_dt + timedelta(hours=16)  # Mon 16:00 UTC = Mon 9am PDT
    week_end_dt = monday_dt + timedelta(days=7)
    now_utc = datetime.now(timezone.utc).replace(tzinfo=None)
    grid_start = monday_9am_pst_utc
    grid_end = min(now_utc, week_end_dt)

    five_min_raw = conn.execute(f"""
        SELECT t.usage_date as bucket, t.model, SUM(t.cost_usd) as cost
        FROM token_usage t
        WHERE LENGTH(COALESCE(t.usage_date, '')) = 16
          AND t.usage_date >= '{monday_9am_pst_utc.isoformat()}'
          AND t.usage_date < '{week_end_dt.date().isoformat()}'
        GROUP BY bucket, t.model
    """).fetchall()
    cost_by_bucket_model = {}
    for r in five_min_raw:
        cost_by_bucket_model.setdefault(r["bucket"], {})[r["model"]] = r["cost"] or 0.0
    week_models = sorted({r["model"] for r in five_min_raw}) or ["(no usage yet)"]

    # Dense grid: one row per 5-min bucket per model (0-filled), so stacked areas
    # stay flat during gaps instead of the line jumping across them.
    work_week_hourly = []  # Still called "hourly" for compat; now holds 5-min data
    cursor = grid_start
    while cursor < grid_end:
        bucket_key = cursor.strftime("%Y-%m-%dT%H:%M")
        bucket_costs = cost_by_bucket_model.get(bucket_key, {})
        for model in week_models:
            work_week_hourly.append({
                "hour": bucket_key, "model": model, "cost": bucket_costs.get(model, 0.0),
            })
        cursor += timedelta(minutes=5)

    # Code Puppy quota overlay: same dense 5-min grid as work_week_hourly, so
    # both series share an x-axis in the front-end. Snapshots are sparse
    # (~hourly, via cron — see log_code_puppy_quota above) relative to the
    # 5-min grid, so forward-fill: the % used holds steady between snapshots
    # and steps up/down at each new one. See
    # docs/2026-08-07_UsageDashboard5MinPST.md § Code Puppy Quota Overlay.
    cpq_raw = conn.execute(f"""
        SELECT captured_at, tokens_used, token_limit, requests_used, request_limit
        FROM code_puppy_quota
        WHERE captured_at >= '{grid_start.isoformat()}'
          AND captured_at < '{grid_end.isoformat()}'
        ORDER BY captured_at
    """).fetchall()

    def _dominant_pct(row):
        """Worse-of-tokens-or-requests %, matching code-puppy's own
        /usage 'dominant indicator' logic (red beats yellow beats green)."""
        pcts = []
        if row["token_limit"]:
            pcts.append(100.0 * (row["tokens_used"] or 0) / row["token_limit"])
        if row["request_limit"]:
            pcts.append(100.0 * (row["requests_used"] or 0) / row["request_limit"])
        return max(pcts) if pcts else None

    cpq_snapshots = []
    for r in cpq_raw:
        try:
            cpq_snapshots.append((datetime.fromisoformat(r["captured_at"]), _dominant_pct(r)))
        except (ValueError, TypeError):
            continue

    code_puppy_quota_series = []
    cpq_idx = 0
    last_pct = None
    cursor = grid_start
    while cursor < grid_end:
        bucket_key = cursor.strftime("%Y-%m-%dT%H:%M")
        while cpq_idx < len(cpq_snapshots) and cpq_snapshots[cpq_idx][0] <= cursor:
            if cpq_snapshots[cpq_idx][1] is not None:
                last_pct = cpq_snapshots[cpq_idx][1]
            cpq_idx += 1
        if last_pct is not None:
            code_puppy_quota_series.append({"hour": bucket_key, "pct": round(last_pct, 1)})
        cursor += timedelta(minutes=5)

    # Reset-anchor for the dashed sawtooth reference line. Code Puppy's 6h
    # quota window resets on a fixed clock schedule — confirmed live
    # 2026-08-10: 05:09 / 11:09 / 17:09 / 23:09 PT, every 6h, phase-anchored
    # at :09 past the hour. Rather than hardcode those clock times (fragile
    # across DST, and an assumption not a fact), derive the *next* reset
    # instant from any single live reading: captured_at + resets_in_secs.
    # The front-end then extrapolates the whole week's sawtooth from that one
    # anchor via modulo-21600s (6h) math — no historical data required, and
    # it self-corrects every time this query runs since log_code_puppy_quota
    # (above) just inserted a fresh row.
    code_puppy_reset_anchor = None
    anchor_row = conn.execute(
        "SELECT captured_at, resets_in_secs FROM code_puppy_quota "
        "ORDER BY captured_at DESC LIMIT 1"
    ).fetchone()
    if anchor_row and anchor_row["resets_in_secs"] is not None:
        try:
            captured_dt = datetime.fromisoformat(anchor_row["captured_at"])
            code_puppy_reset_anchor = (
                captured_dt + timedelta(seconds=anchor_row["resets_in_secs"])
            ).isoformat()
        except (ValueError, TypeError):
            pass

    week_cost_so_far = sum(r["cost"] for r in five_min_raw)

    # Weekly $ limit: local token math doesn't match Wibey's internal quota
    # formula (verified 2026-08-07: local token count said 35% used, the
    # Wibey UI widget said 49% used, at the same moment) — so instead of
    # guessing a token-to-dollar conversion, calibrate directly off a
    # (%, $cost) point read from the Wibey UI. Recalibrate any week via:
    #   wibey-usage calibrate --pct 49
    weekly_limit = get_weekly_limit(monday, week_cost_so_far)

    summary = conn.execute("""
        SELECT
            COUNT(DISTINCT s.session_id) as total_sessions,
            COALESCE(SUM(t.input_tokens), 0) as total_input,
            COALESCE(SUM(t.output_tokens), 0) as total_output,
            COALESCE(SUM(t.cache_read), 0) as total_cache_read,
            COALESCE(SUM(t.cache_creation), 0) as total_cache_create,
            COALESCE(SUM(t.cost_usd), 0) as total_cost,
            COALESCE(SUM(s.duration_secs), 0) as total_duration,
            COALESCE(SUM(s.message_count), 0) as total_messages,
            MIN(s.started_at) as first_session,
            MAX(s.ended_at) as last_session
        FROM sessions s
        LEFT JOIN token_usage t ON s.session_id = t.session_id
    """).fetchone()

    model_totals = conn.execute("""
        SELECT model, SUM(cost_usd) as cost,
               SUM(input_tokens) as input_tok,
               SUM(output_tokens) as output_tok,
               SUM(cache_read) as cache_read,
               SUM(cache_creation) as cache_create
        FROM token_usage GROUP BY model ORDER BY cost DESC
    """).fetchall()

    project_totals = conn.execute("""
        SELECT s.project, SUM(t.cost_usd) as cost,
               COUNT(DISTINCT s.session_id) as sessions
        FROM sessions s
        JOIN token_usage t ON s.session_id = t.session_id
        GROUP BY s.project ORDER BY cost DESC LIMIT 15
    """).fetchall()

    sessions_list = conn.execute("""
        SELECT s.session_id, s.project, s.git_branch, s.reason,
               s.started_at, s.ended_at, s.duration_secs, s.message_count,
               SUM(t.input_tokens) as input_tok,
               SUM(t.output_tokens) as output_tok,
               SUM(t.cache_read) as cache_read,
               SUM(t.cache_creation) as cache_create,
               SUM(t.cost_usd) as cost,
               GROUP_CONCAT(DISTINCT t.model) as models
        FROM sessions s
        LEFT JOIN token_usage t ON s.session_id = t.session_id
        GROUP BY s.session_id
        ORDER BY s.ended_at DESC
    """).fetchall()

    # Tool usage data
    tool_totals = conn.execute("""
        SELECT tool_name, SUM(call_count) as calls, SUM(error_count) as errors,
               COUNT(DISTINCT session_id) as sessions
        FROM tool_usage GROUP BY tool_name ORDER BY calls DESC
    """).fetchall()

    daily_tools = conn.execute("""
        SELECT usage_date as day, tool_name, SUM(call_count) as calls,
               SUM(error_count) as errors
        FROM tool_usage
        WHERE usage_date IS NOT NULL
        GROUP BY usage_date, tool_name
        ORDER BY day
    """).fetchall()

    # Skill usage data
    skill_totals = conn.execute("""
        SELECT skill_name, SUM(invocation_count) as invocations,
               COUNT(DISTINCT session_id) as sessions,
               MAX(usage_date) as last_used
        FROM skill_usage GROUP BY skill_name ORDER BY invocations DESC
    """).fetchall()

    daily_skills = conn.execute("""
        SELECT usage_date as day, skill_name, SUM(invocation_count) as invocations
        FROM skill_usage
        WHERE usage_date IS NOT NULL
        GROUP BY usage_date, skill_name
        ORDER BY day
    """).fetchall()

    conn.close()

    # Build JSON data payload
    dashboard_data = {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "summary": dict(summary),
        "daily": [dict(r) for r in daily],
        "work_week_hourly": [dict(r) for r in work_week_hourly],
        "weekly_limit": weekly_limit,  # Calculated from actual token usage ratio
        "code_puppy_quota_series": code_puppy_quota_series,  # forward-filled % overlay
        "code_puppy_quota_now": code_puppy_quota_now,  # live snapshot, or None
        "code_puppy_reset_anchor": code_puppy_reset_anchor,  # ISO instant of a known 6h reset
        "model_totals": [dict(r) for r in model_totals],
        "project_totals": [
            {**dict(r), "project": shorten_project(r["project"])} for r in project_totals
        ],
        "sessions": [
            {**dict(r), "project": shorten_project(r["project"])} for r in sessions_list
        ],
        "tool_totals": [dict(r) for r in tool_totals],
        "daily_tools": [dict(r) for r in daily_tools],
        "skill_totals": [dict(r) for r in skill_totals],
        "daily_skills": [dict(r) for r in daily_skills],
    }

    html = generate_dashboard_html(dashboard_data)

    out_path = Path(args.output) if args.output else Path.home() / ".wibey" / "usage" / "dashboard.html"
    out_path.parent.mkdir(parents=True, exist_ok=True)
    with open(out_path, "w") as f:
        f.write(html)

    print(f"Dashboard written to {out_path}")

    # Open in browser (skip for cron / headless runs)
    if getattr(args, "no_open", False):
        return
    if sys.platform == "darwin":
        subprocess.run(["open", str(out_path)])
    elif sys.platform == "linux":
        subprocess.run(["xdg-open", str(out_path)])
    else:
        subprocess.run(["start", "", str(out_path)], shell=True)


# ── Backfill ─────────────────────────────────────────────────────────────────

def cmd_backfill(args):
    """Scan all historical transcript files and backfill the database."""
    claude_dir = Path.home() / ".claude" / "projects"
    if not claude_dir.exists():
        print("No transcript directory found.")
        return

    conn = init_db()
    count = 0
    skipped = 0

    transcript_files = sorted(claude_dir.rglob("*.jsonl"))
    total = len(transcript_files)
    print(f"Found {total} transcript files. Scanning...")

    for i, path in enumerate(transcript_files):
        # Skip agent transcripts (subagent sessions) unless --include-agents
        if not args.include_agents and path.name.startswith("agent-"):
            skipped += 1
            continue

        if (i + 1) % 25 == 0:
            print(f"  [{i + 1}/{total}] Processing...")

        data = parse_transcript(str(path))
        if data["message_count"] == 0:
            skipped += 1
            continue

        try:
            store_session(conn, data, reason="backfill", force=True)
            count += 1
        except Exception:
            skipped += 1

    conn.close()
    print(f"\nBackfill complete: {count} sessions imported, {skipped} skipped.")


# ── Helpers ──────────────────────────────────────────────────────────────────

def shorten_project(path: str) -> str:
    """Shorten a project path for display."""
    if not path:
        return "(unknown)"
    home = str(Path.home())
    if path.startswith(home):
        path = "~" + path[len(home):]
    # Further shorten: keep last 2 segments
    parts = path.split("/")
    if len(parts) > 3:
        return ".../" + "/".join(parts[-2:])
    return path


def format_duration(secs: float) -> str:
    """Format seconds into a human-readable duration."""
    if secs < 60:
        return f"{secs:.0f}s"
    if secs < 3600:
        return f"{secs / 60:.0f}m"
    hours = secs / 3600
    if hours < 24:
        return f"{hours:.1f}h"
    return f"{hours / 24:.1f}d"


def generate_dashboard_html(data: dict) -> str:
    """Generate a self-contained HTML dashboard."""
    data_json = json.dumps(data, default=str)
    return DASHBOARD_TEMPLATE.replace("__DATA_PLACEHOLDER__", data_json)


