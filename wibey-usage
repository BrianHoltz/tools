// ── Day Border Plugin (vertical dashed lines at PST midnight) ───────────
// Inline Chart.js plugin — no extra CDN dependency. Reads chart.$dayBorders
// (array of {index, label} set after chart creation) and draws dashed
// vertical lines + a small day label at the top of each.
const dayBorderPlugin = {
  id: 'dayBorders',
  afterDraw(chart) {
    const borders = chart.$dayBorders;
    if (!borders || !borders.length) return;
    const { ctx, chartArea, scales: { x } } = chart;
    ctx.save();
    ctx.strokeStyle = 'rgba(139, 148, 158, 0.45)';
    ctx.setLineDash([4, 4]);
    ctx.font = '10px -apple-system, sans-serif';
    ctx.fillStyle = '#8b949e';
    borders.forEach(({ index, label }) => {
      const xPos = x.getPixelForValue(index);
      ctx.beginPath();
      ctx.moveTo(xPos, chartArea.top);
      ctx.lineTo(xPos, chartArea.bottom);
      ctx.stroke();
      ctx.fillText(label, xPos + 4, chartArea.top + 12);
    });
    ctx.restore();
  },
};
Chart.register(dayBorderPlugin);

// ── Work Week Cumulative Cost (stacked-by-model area, PST, day borders) ─
function renderWorkWeekCost(workWeekData, weeklyLimit, cpQuotaSeries, cpResetAnchor) {
  destroyChart('workWeek');
  if (!workWeekData.length) return;

  // Group rows (bucket, model, cost) by bucket, preserving bucket order
  const buckets = [];
  const byBucket = {};
  workWeekData.forEach(r => {
    if (!byBucket[r.hour]) { byBucket[r.hour] = {}; buckets.push(r.hour); }
    byBucket[r.hour][r.model] = r.cost || 0;
  });

  // Rank models by total cost so far this week — most expensive stacks on
  // top (rendered last), least expensive on the bottom (rendered first).
  const modelTotals = {};
  workWeekData.forEach(r => { modelTotals[r.model] = (modelTotals[r.model] || 0) + (r.cost || 0); });
  const modelsLowToHigh = Object.keys(modelTotals).sort((a, b) => modelTotals[a] - modelTotals[b]);

  // PST labels + day-border indices (once per unique bucket: hour or 5-min)
  const timeLabels = [];
  const axisLabels = [];  // 'Dow HH' on the hour, '' otherwise — never finer than hourly
  const dayBorders = [];
  let lastPstDate = null;
  buckets.forEach((bucket, i) => {
    // Handle both hourly (YYYY-MM-DDTHH) and 5-min (YYYY-MM-DDTHH:MM) formats
    const utcDt = new Date(bucket.length === 13 ? bucket + ':00:00Z' : bucket + ':00Z');
    const pstParts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Los_Angeles',
      weekday: 'short', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hour12: false,
    }).formatToParts(utcDt);
    const get = t => pstParts.find(p => p.type === t)?.value;
    const pstDateKey = `${get('month')}/${get('day')}`;
    timeLabels.push(`${pstDateKey} ${get('hour')}:${get('minute')}`);
    axisLabels.push(get('minute') === '00' ? `${get('weekday')} ${get('hour')}` : '');
    if (pstDateKey !== lastPstDate) {
      dayBorders.push({ index: i, label: `${get('weekday')} ${pstDateKey}` });
      lastPstDate = pstDateKey;
    }
  });

  // Per-model cumulative series, stacked bottom (cheap) -> top (expensive)
  const modelDatasets = modelsLowToHigh.map(model => {
    let cum = 0;
    const data = buckets.map(bucket => { cum += (byBucket[bucket][model] || 0); return cum; });
    const color = mc(model);
    return {
      label: model,
      data,
      borderColor: color,
      backgroundColor: color + '99',  // ~60% opacity fill
      fill: true,
      stepped: 'after',
      pointRadius: 0,
      borderWidth: 1,
      stack: 'models',
      yAxisID: 'y',
    };
  });

  // Perfect pace line: 20% per workday (9am-5pm PST Mon-Fri = 40 hours total)
  // During work hours: cumulative = (hours_elapsed_in_work / 40) * weeklyLimit
  // Outside work hours: flat (no usage expected)
  const limitLine = buckets.map((bucket) => {
    const utcDt = new Date(bucket.length === 13 ? bucket + ':00:00Z' : bucket + ':00Z');
    const pstFormatter = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Los_Angeles',
      weekday: 'short',
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hour12: false,
    });
    const pstParts = pstFormatter.formatToParts(utcDt);
    const get = t => pstParts.find(p => p.type === t)?.value;
    const hour = parseInt(get('hour'));
    // Extract PST weekday from PST formatter (NOT UTC getUTCDay)
    const dayOfWeekMap = { 'Mon': 1, 'Tue': 2, 'Wed': 3, 'Thu': 4, 'Fri': 5, 'Sat': 6, 'Sun': 0 };
    const pstWeekday = get('weekday');
    const dayOfWeek = dayOfWeekMap[pstWeekday] !== undefined ? dayOfWeekMap[pstWeekday] : 0;

    // Work hours: Mon-Fri (dayOfWeek 1-5), 9am-5pm PST
    const pstHour = parseInt(get('hour'));
    const isWorkHour = (dayOfWeek >= 1 && dayOfWeek <= 5) && pstHour >= 9 && pstHour < 17;

    if (!isWorkHour) return 0; // Will be filled to previous value below

    // Calculate which workday (0-4) and hour within that day (0-8)
    const daysElapsed = dayOfWeek - 1;
    const hoursIntoDay = pstHour - 9;
    const minutes = parseInt(get('minute'));
    const totalHoursElapsed = daysElapsed * 8 + hoursIntoDay + (minutes / 60);

    return (totalHoursElapsed / 40) * weeklyLimit;
  });

  // Convert limitLine to cumulative (hold at previous value during off-hours)
  let lastWorkValue = 0;
  for (let i = 0; i < limitLine.length; i++) {
    if (limitLine[i] > 0) lastWorkValue = limitLine[i];
    else limitLine[i] = lastWorkValue;
  }

  // Code Puppy quota overlay — actual line + sawtooth pace + red dot at current reading.
  const cpQuotaByBucket = {};
  (cpQuotaSeries || []).forEach(r => { cpQuotaByBucket[r.hour] = r.pct; });
  const cpQuotaData = buckets.map(b => cpQuotaByBucket[b] ?? null);
  const lastCpIdx = cpQuotaData.reduce((acc, v, i) => v !== null ? i : acc, -1);
  const hasCpQuota = lastCpIdx >= 0;
  const cpDotData = buckets.map((_, i) => i === lastCpIdx ? cpQuotaData[lastCpIdx] : null);

  // Dashed reference sawtooth: ideal 6h ceiling, purely time-based.
  const SIX_HOURS_MS = 6 * 60 * 60 * 1000;
  let cpSawtoothData = null;
  if (cpResetAnchor) {
    const anchorIso = cpResetAnchor.endsWith('Z') ? cpResetAnchor : cpResetAnchor + 'Z';
    const anchorMs = new Date(anchorIso).getTime();
    cpSawtoothData = buckets.map(bucket => {
      const bucketMs = new Date(bucket.length === 13 ? bucket + ':00:00Z' : bucket + ':00Z').getTime();
      const phase = (((bucketMs - anchorMs) % SIX_HOURS_MS) + SIX_HOURS_MS) % SIX_HOURS_MS;
      return (phase / SIX_HOURS_MS) * 100;
    });
  }

  // Both axes always span the full weekly budget: left = $0→weeklyLimit, right = 0→100%.
  // A data point at $X on the left reads as X/weeklyLimit*100% on the right — always in sync.

  charts.workWeek = new Chart(document.getElementById('workWeekChart'), {
    type: 'line',
    data: {
      labels: timeLabels,
      datasets: [
        ...modelDatasets,
        {
          label: 'Wibey 7d pace',
          data: limitLine,
          borderColor: '#39d2c0',
          borderWidth: 2,
          borderDash: [5, 5],
          fill: false,
          tension: 0,
          pointRadius: 0,
          stack: 'limit',
          yAxisID: 'y',
        },
        ...(hasCpQuota ? [{
          label: 'CP quota % used',
          data: cpQuotaData,
          borderColor: '#e0af68',
          backgroundColor: '#e0af68',
          borderWidth: 2,
          fill: false,
          stepped: 'before',
          pointRadius: 0,
          spanGaps: true,
          yAxisID: 'y2',
        }] : []),
        ...(cpSawtoothData ? [{
          label: 'CP quota 6h pace',
          data: cpSawtoothData,
          borderColor: '#e0af6899',
          borderWidth: 1,
          borderDash: [3, 3],
          fill: false,
          tension: 0,
          pointRadius: 0,
          yAxisID: 'y2',
        }] : []),
        ...(hasCpQuota ? [{
          label: 'CP quota now',
          data: cpDotData,
          borderColor: '#f85149',
          backgroundColor: '#f85149',
          borderWidth: 0,
          pointRadius: 7,
          pointHoverRadius: 9,
          fill: false,
          spanGaps: false,
          yAxisID: 'y2',
        }] : []),
      ],
    },
    options: {
      responsive: true,
      plugins: {
        legend: { labels: { color: '#8b949e', font: { size: 11 } } },
        tooltip: {
          callbacks: {
            label: ctx => ctx.dataset.yAxisID === 'y2'
              ? ctx.dataset.label + ': ' + ctx.raw.toFixed(1) + '%'
              : ctx.dataset.label + ': $' + ctx.raw.toFixed(2),
          },
        },
      },
      scales: {
        x: {
          ticks: {
            color: '#8b949e', font: { size: 9 }, maxRotation: 90,
            // 'Dow HH' labels, hour-aligned only — never finer than hourly
            // granularity even though the underlying grid is 5-min buckets.
            callback: (val, idx) => axisLabels[idx] || '',
            autoSkip: false,
          },
          grid: { color: '#21262d' },
        },
        y: {
          stacked: true,
          min: 0,
          max: weeklyLimit,
          ticks: { color: '#39d2c0', callback: v => '$' + v.toFixed(0) },
          grid: { color: '#21262d' },
          position: 'left',
        },
        y2: {
          display: true,
          min: 0,
          max: 100,
          position: 'right',
          ticks: { color: '#39d2c0', callback: v => v + '%' },
          grid: { drawOnChartArea: false },
        },
      },
    },
  });

  charts.workWeek.$dayBorders = dayBorders;
  charts.workWeek.update();
}

// ── Fine-Grain Cost (5-min buckets, last 2 days, PST) ───────────────────
function renderFineGrainCost(fineGrain) {
  destroyChart('fineGrain');
  if (!fineGrain.length) return;

  const byModel = {};
  const bucketToPST = {};
  fineGrain.forEach(r => {
    if (!byModel[r.model]) byModel[r.model] = {};
    // Convert UTC bucket (YYYY-MM-DDTHH:MM) to PST label
    if (!bucketToPST[r.bucket]) {
      try {
        const utcDt = new Date(r.bucket + ':00Z');
        const pstStr = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Los_Angeles',
          month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
          hour12: false,
        }).format(utcDt);
        bucketToPST[r.bucket] = pstStr;  // MM/DD HH:MM
      } catch (e) {
        bucketToPST[r.bucket] = r.bucket;
      }
    }
    const pstLabel = bucketToPST[r.bucket];
    byModel[r.model][pstLabel] = (byModel[r.model][pstLabel]||0) + r.cost;
  });
  const labels = [...new Set(fineGrain.map(r => bucketToPST[r.bucket]))].sort();
  const models = Object.keys(byModel);

  charts.fineGrain = new Chart(document.getElementById('hourlyCostChart'), {
    type: 'bar',
    data: {
      labels: labels,
      datasets: models.map(m => ({
        label: m, data: labels.map(l => byModel[m][l] || 0),
        backgroundColor: mc(m), borderRadius: 2, barPercentage: 0.85,
      })),
    },
    options: { ...CHART_OPTS,
      scales: { ...CHART_OPTS.scales,
        x: { ...CHART_OPTS.scales.x, stacked: true, ticks: { ...CHART_OPTS.scales.x.ticks, maxRotation: 90, font: { size: 9 } } },
        y: { ...CHART_OPTS.scales.y, stacked: true, ticks: { ...CHART_OPTS.scales.y.ticks, callback: v => '$'+v.toFixed(1) } },
      },
      plugins: { ...CHART_OPTS.plugins,
        tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': $' + ctx.raw.toFixed(2) } },
      },
    },
  });
}

function renderDailyCost(daily) {
  destroyChart('dailyCost');
  const byModel = {};
  daily.forEach(r => {
    if (!byModel[r.model]) byModel[r.model] = {};
    byModel[r.model][r.day] = (byModel[r.model][r.day]||0) + r.cost;
  });
  const days = [...new Set(daily.map(r => r.day))].sort();
  const models = Object.keys(byModel);

  // Trend calculation
  const dailyCosts = {};
  daily.forEach(r => { dailyCosts[r.day] = (dailyCosts[r.day]||0) + r.cost; });
  const costArr = days.map(d => dailyCosts[d] || 0);
  let trendText = '';
  if (costArr.length >= 7) {
    const recent = costArr.slice(-7).reduce((a,b)=>a+b,0) / 7;
    const prev = costArr.slice(-14,-7).reduce((a,b)=>a+b,0) / Math.min(7, costArr.slice(-14,-7).length || 1);
    if (prev > 0) {
      const pct = ((recent - prev) / prev * 100);
      trendText = (pct >= 0 ? '\u25B2' : '\u25BC') + ' ' + Math.abs(pct).toFixed(0) + '% vs prior 7d (avg ' + fmtCost(recent) + '/day)';
    }
  }
  document.getElementById('costTrend').textContent = trendText;

  charts.dailyCost = new Chart(document.getElementById('dailyCostChart'), {
    type: 'bar',
    data: {
      labels: days,
      datasets: models.map(m => ({
        label: m, data: days.map(d => byModel[m][d] || 0),
        backgroundColor: mc(m), borderRadius: 3, barPercentage: 0.85,
      })),
    },
    options: { ...CHART_OPTS,
      scales: { ...CHART_OPTS.scales,
        x: { ...CHART_OPTS.scales.x, stacked: true },
        y: { ...CHART_OPTS.scales.y, stacked: true, ticks: { ...CHART_OPTS.scales.y.ticks, callback: v => '$'+v } },
      },
    },
  });
}

