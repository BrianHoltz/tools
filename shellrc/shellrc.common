# ~/bin/shellrc.common — shared PATH and environment for zsh + bash
# Canonical location: ~/bin/shellrc.common (symlinked from ~/.shellrc.common)
# Sourced by both ~/bin/zshrc and ~/bin/bash_profile
# One-time host setup: bash ~/bin/shellrc/setup.sh [-n]

if [ -n "${SHELLRC_COMMON_LOADED-}" ]; then
    return 0
fi
SHELLRC_COMMON_LOADED=1

path_prepend() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1${PATH:+:$PATH}" ;;
    esac
}

path_append() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="${PATH:+$PATH:}$1" ;;
    esac
}

# --- Java ---
if [ -d /Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home ]; then
    export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
elif command -v /usr/libexec/java_home >/dev/null 2>&1; then
    export JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null)
fi
[ -n "$JAVA_HOME" ] && path_prepend "$JAVA_HOME/bin"

# --- jenv (must come after JAVA_HOME so shims take precedence) ---
if command -v jenv > /dev/null 2>&1; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(jenv init - zsh)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(jenv init - bash)"
    fi
fi

# --- User scripts ---
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"

# --- Homebrew tools (shared for zsh + bash) ---
if command -v brew >/dev/null 2>&1; then
    _brew_prefix="$(brew --prefix)"
    path_prepend "$_brew_prefix/opt/rsync/bin"
    path_prepend "$_brew_prefix/bin"
    unset _brew_prefix
fi

# --- Google Cloud SDK ---
_gcloud_dir="$HOME/google-cloud-sdk"
if [ -n "$ZSH_VERSION" ]; then
    [ -f "$_gcloud_dir/path.zsh.inc" ] && . "$_gcloud_dir/path.zsh.inc"
    [ -f "$_gcloud_dir/completion.zsh.inc" ] && . "$_gcloud_dir/completion.zsh.inc"
elif [ -n "$BASH_VERSION" ]; then
    [ -f "$_gcloud_dir/path.bash.inc" ] && . "$_gcloud_dir/path.bash.inc"
    [ -f "$_gcloud_dir/completion.bash.inc" ] && . "$_gcloud_dir/completion.bash.inc"
fi
unset _gcloud_dir

# --- Credentials ---
[ -f ~/qualityeng-prod-sa1-key.json ] && export GOOGLE_APPLICATION_CREDENTIALS=~/qualityeng-prod-sa1-key.json

# --- SSH ---
ssh-add ~/.ssh/app_id.rsa 2>/dev/null

# --- Sledge ---
export SLEDGE_BIN="$HOME/.sledge/bin"
path_append "$SLEDGE_BIN"

# --- Kafka ---
path_append "/opt/homebrew/opt/kafka/bin"

# --- Wibey CLI ---
export BUN_INSTALL_CACHE_DIR="$HOME/.local/share/bun/cache"

# --- VS Code CLI ---
path_append "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
path_append "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"

# --- Python aliases ---
if command -v python3 >/dev/null 2>&1; then
    alias python="python3"
    alias pip="pip3"
fi

# --- Shell functions ---
lslast() {
    last=$(ls -At ${1+"$@"} | head -1)
    echo ${1+"$@/"}$last
}
lesslast() {
    less +F $(lslast ${1+"$@"})
}
lsnew() {
    ls -lthog ${1+"$@"} | grep -v '^total' | head
}
alias lll="lesslast logs"
